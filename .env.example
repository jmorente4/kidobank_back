# Entorno actual: local, staging, production
ENVIRONMENT=local
PROJECT_NAME=your_project_name_here

# Base de Datos PostgreSQL local
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username_here
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=your_database_name_here

# Seguridad
SECRET_KEY=clave_super_secreta_para_jwt_cambiar_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuración CORS (Permitir conexión desde el frontend de React)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Recuperación de contraseña (SMTP; completar para habilitar el flujo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_URL=http://localhost:5173/reset-password