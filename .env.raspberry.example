# Copy to .env.raspberry on the Raspberry Pi; never commit the real file.
# Generate two DIFFERENT random hex values of at least 32 bytes for these secrets.
POSTGRES_DB=kidobank
POSTGRES_USER=kidobank
POSTGRES_PASSWORD=
SECRET_KEY=

# Replace this sample IP with the actual Raspberry Pi LAN IP.
# Match the exact origin used by the browser (scheme, host and port).
CORS_ORIGINS=["http://192.168.1.100:8081"]
API_BIND_IP=0.0.0.0
API_PORT=8000
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: leave SMTP variables absent until password recovery is configured.
SMTP_PORT=587
SMTP_USE_TLS=true
PASSWORD_RESET_URL=http://192.168.1.100:8081/reset-password
